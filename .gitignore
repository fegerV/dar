```
# Android build outputs
*.apk
*.aar
*.jar
*.so

# Android generated files
gen/
bin/
obj/

# Android local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
*.ipr
*.iws
.idea/

# Gradle
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Keystore files
*.keystore
*.jks

# Generated Javadoc
doc/

# Android coverage reports
coverage/

# No .classList files should be kept in version control
*.class

# generated using "gradle wrapper" command
gradle/wrapper/

# Exclude all files in assets folder from git
assets/

# Exclude native build outputs
jniLibs/
lib/
```