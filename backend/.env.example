# DarAgent Backend Configuration
# Copy to .env and fill in values

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-secret
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://daragent:daragent@localhost:5432/daragent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage (MinIO for dev, Yandex Disk for prod)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=daragent
MINIO_SECURE=false

# Yandex Disk (production)
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_BASE_PATH=/daragent

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RETURN_URL=http://localhost:8000/api/v1/payments/callback

# AI Providers
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# Notifications
FCM_SERVICE_ACCOUNT_JSON=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
