FROM python:3.11-slim AS base

RUN groupadd -r -g 1001 daragent \
    && useradd -r -u 1001 -g daragent \
    -d /app \
    -s /bin/false \
    -c "DarAgent Application" \
    daragent

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

RUN pip install --no-cache-dir --no-warn-script-location uvicorn[standard]

COPY --chown=daragent:daragent --chmod=600 pyproject.toml ./
RUN pip install --no-cache-dir -e ".[prod]"

USER daragent

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
